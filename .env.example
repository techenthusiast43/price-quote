# ==============================================================================
# PriceQuote - Root Environment Template
# Duplicate this file as .env and fill in your values
# ==============================================================================

# Deployer wallet private key (starts with 0x)
PRIVATE_KEY="0xYOUR_BOT_CHAIN_PRIVATE_KEY_HERE"

# Reown Project ID from https://cloud.reown.com
REOWN_PROJECT_ID="YOUR_REOWN_PROJECT_ID_HERE"

# BOT Chain Testnet
BOT_CHAIN_TESTNET_RPC="https://rpc.bohr.life"
BOT_CHAIN_TESTNET_CHAIN_ID=968

# BOT Chain Mainnet
BOT_CHAIN_MAINNET_RPC="https://rpc.botchain.ai"
BOT_CHAIN_MAINNET_CHAIN_ID=677

